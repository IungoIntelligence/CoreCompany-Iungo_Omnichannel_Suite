<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><title>Iungo The North Face Essencial</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=Roboto+Condensed:wght@400;500;700&family=Roboto:wght@400;500&display=swap">
<style>
/* Layout: four glowing frames on deep navy — produto, três inteligências, resultados, piloto. Single dark world by design. */
:root{
  color-scheme:dark;
  --bg:#051028; --bg-2:#0a1c46;
  --line:rgba(96,165,255,.42); --line-soft:rgba(96,165,255,.18);
  --fg:#f2f6ff; --dim:#a8b8de; --mute:#7085b5;
  --blue:#3d86ff; --cyan:#4fd0ff; --violet:#8c7bff; --green:#3be39c; --orange:#ff8a3d; --red:#ff4f6d; --amber:#ffb547;
  --display:"Montserrat","Segoe UI",system-ui,sans-serif;
  --cond:"Roboto Condensed","Arial Narrow",system-ui,sans-serif;
  --body:"Roboto","Segoe UI",system-ui,sans-serif;
}
*{box-sizing:border-box}
html{background:var(--bg)}
body{margin:0;color:var(--fg);font-family:var(--body);font-size:17px;line-height:1.55;
  background:radial-gradient(1200px 700px at 85% -10%,rgba(61,134,255,.28),transparent 60%),radial-gradient(900px 600px at -10% 30%,rgba(140,123,255,.14),transparent 60%),linear-gradient(180deg,var(--bg-2) 0,var(--bg) 900px,var(--bg))}
h1,h2,h3,h4{margin:0;text-wrap:balance}
p{margin:0}
a{color:inherit}
:focus-visible{outline:3px solid var(--cyan);outline-offset:3px;border-radius:6px}
.wrap{max-width:1180px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.sec{padding-block:clamp(12px,1.8vw,20px)}
.frame{position:relative;border:1px solid var(--line);border-radius:28px;padding:clamp(24px,4.4vw,56px);background:linear-gradient(180deg,rgba(16,41,95,.55),rgba(7,20,50,.55));box-shadow:0 0 40px rgba(61,134,255,.12),inset 0 1px 0 rgba(255,255,255,.06)}
.glow{border:1px solid var(--line);border-radius:18px;background:rgba(12,32,80,.6);box-shadow:0 0 22px rgba(61,134,255,.16),inset 0 0 24px rgba(61,134,255,.06)}
.eyebrow{font-family:var(--cond);font-weight:700;font-size:.85rem;letter-spacing:.14em;text-transform:uppercase;color:var(--cyan)}
.hl{color:var(--orange)}
.sec-head{display:grid;gap:12px;max-width:820px;margin-bottom:clamp(26px,3.6vw,44px)}
.sec-head h2{font-family:var(--display);font-weight:800;font-size:clamp(1.8rem,3.8vw,2.8rem);line-height:1.08;letter-spacing:-.02em}
.sec-head p{color:var(--dim);font-size:1.08rem;max-width:62ch}
.note{color:var(--mute);font-size:.8rem}
.chip{font-family:var(--cond);font-size:.85rem;color:var(--fg);padding:4px 11px;border-radius:999px;border:1px solid var(--line);background:rgba(61,134,255,.1);white-space:nowrap}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.progress{position:fixed;top:0;left:0;right:0;height:calc(3px + env(safe-area-inset-top,0px));z-index:20;pointer-events:none}
.progress span{position:absolute;left:0;right:0;bottom:0;height:3px;background:linear-gradient(90deg,var(--cyan),var(--blue),var(--orange));transform-origin:left;transform:scaleX(var(--sp,0));box-shadow:0 0 12px var(--cyan)}
.appi{flex:none;width:30px;height:30px;border-radius:8px;background:linear-gradient(135deg,#ff5a4f,#d9232f);display:grid;place-items:center}
.appi i{display:inline-flex;gap:2px}
.appi i b{width:4px;height:14px;background:#fff;transform:skewX(-16deg);border-radius:1px}

/* HERO */
.hero{position:relative;overflow:hidden;padding-block:clamp(28px,4vw,44px) 8px}
.hero::before{content:"";position:absolute;left:-10%;right:-10%;bottom:-60px;height:320px;pointer-events:none;background-image:linear-gradient(rgba(79,208,255,.15) 1px,transparent 1px),linear-gradient(90deg,rgba(79,208,255,.15) 1px,transparent 1px);background-size:56px 56px;transform:perspective(500px) rotateX(62deg);transform-origin:bottom;-webkit-mask-image:linear-gradient(transparent,#000 70%);mask-image:linear-gradient(transparent,#000 70%)}
.topbar{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}
.logo{display:flex;align-items:center;gap:10px;font-family:var(--display);font-weight:800;font-size:1.35rem;letter-spacing:-.02em}
.logo i{display:inline-flex;gap:3px}
.logo i b{width:7px;height:24px;background:#fff;transform:skewX(-14deg);border-radius:1px}
.logo i b+b{background:var(--blue)}
.tag{font-family:var(--cond);font-weight:700;font-size:.85rem;letter-spacing:.06em;text-transform:uppercase;padding:7px 14px;border:1px solid var(--line);border-radius:999px;color:var(--dim);background:rgba(12,32,80,.5)}
.hero-grid{position:relative;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:clamp(20px,4vw,48px);align-items:center;margin-top:clamp(28px,5vw,52px)}
.hero-copy{container-type:inline-size;min-width:0}
.hero h1{font-family:var(--display);font-weight:800;font-size:min(4rem,7.6cqi);line-height:1.03;letter-spacing:-.03em;margin-top:14px}
.hero .lede{color:var(--dim);font-size:clamp(1.05rem,1.6vw,1.22rem);line-height:1.5;margin-top:22px;max-width:52ch}
.hero .lede b{color:var(--orange);font-weight:500}
.h1-key{white-space:nowrap;display:block}
.levels{display:flex;flex-wrap:wrap;align-items:flex-end;gap:10px;margin-top:28px}
.lv{display:grid;gap:4px;padding:12px 16px;border-radius:14px;border:1px solid var(--line-soft);background:rgba(12,32,80,.35)}
.lv small{font-family:var(--cond);font-weight:700;font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:var(--mute)}
.lv b{font-family:var(--cond);font-weight:700;font-size:1.02rem}
.lv:nth-child(1){min-height:64px}
.lv:nth-child(2){min-height:80px}
.lv:nth-child(3){min-height:96px;border-color:var(--orange);background:rgba(255,138,61,.1);box-shadow:0 0 20px rgba(255,138,61,.25)}
.lv:nth-child(3) small{color:var(--orange)}
.stage{position:relative;aspect-ratio:1/1.05;max-width:440px;width:100%;justify-self:center;display:grid;place-items:center}
.stage svg.orbits{position:absolute;inset:-8%;width:116%;height:116%;overflow:visible}
.orb-spin{transform-box:view-box;transform-origin:250px 250px;animation:spin 40s linear infinite}
.orb-scroll{transform-box:view-box;transform-origin:250px 250px;transform:rotate(var(--rot,0deg))}
@keyframes spin{to{transform:rotate(360deg)}}
.phone{position:relative;width:min(240px,60vw);aspect-ratio:9/18.5;border-radius:38px;background:#0a0e18;border:2px solid #4b5677;padding:9px;box-shadow:0 30px 60px -20px rgba(0,0,0,.7),0 0 50px rgba(61,134,255,.35);transform:rotate(-6deg)}
.screen{position:relative;height:100%;border-radius:30px;background:linear-gradient(180deg,#1b2f66,#0c1a3e);overflow:hidden;display:flex;flex-direction:column;gap:8px;padding:44px 10px 10px}
.notch{position:absolute;top:8px;left:50%;width:34%;height:20px;border-radius:12px;background:#0a0e18;transform:translateX(-50%)}
.clock{text-align:center;font-family:var(--display);font-weight:600;font-size:2.4rem;color:#fff;line-height:1}
.date{text-align:center;font-size:.72rem;color:#c5d2f3;margin-bottom:10px}
.pn{display:flex;gap:8px;align-items:flex-start;padding:9px 10px;border-radius:14px;background:rgba(240,244,252,.94);color:#0b1736;font-size:.72rem;line-height:1.3;animation:pushIn .7s cubic-bezier(.2,.8,.2,1) both}
.pn .appi{width:24px;height:24px;border-radius:6px}
.pn .appi i b{width:3px;height:11px}
.pn small{display:block;font-size:.6rem;color:#5d6b8e}
.pn:nth-of-type(1){animation-delay:.5s}.pn:nth-of-type(2){animation-delay:1.1s}.pn:nth-of-type(3){animation-delay:1.7s}
@keyframes pushIn{from{opacity:0;transform:translateY(-14px) scale(.96)}}

/* PRODUCTS */
.prods{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.pc{--c:var(--cyan);padding:24px 22px;display:flex;flex-direction:column;gap:14px;border-top:3px solid var(--c);transition:translate .25s ease,border-color .25s ease}
.pc:hover{translate:0 -4px}
.pc-top{display:flex;align-items:center;gap:14px}
.picon{flex:none;width:64px;height:64px;filter:drop-shadow(0 0 14px var(--c))}
.bulb{flex:none;width:58px;height:58px;border-radius:50%;display:grid;place-items:center;color:var(--c);background:radial-gradient(circle at 50% 40%,rgba(255,255,255,.08),rgba(5,16,40,.92) 70%);border:2px solid var(--c);box-shadow:0 0 16px var(--c),inset 0 0 16px -6px var(--c)}
.bulb svg{width:26px;height:26px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.pname{font-family:var(--cond);font-weight:700;font-size:.8rem;letter-spacing:.1em;text-transform:uppercase;color:var(--c)}
.pc h3{font-family:var(--display);font-weight:800;font-size:1.3rem;line-height:1.15}
.pc > p{color:var(--dim);font-size:.96rem}
.demo{margin-top:auto;display:grid;gap:8px}
.demo-l{font-family:var(--cond);font-weight:700;font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;color:var(--mute)}
.msg{border-radius:16px;padding:12px;background:#f3f5fa;color:#0b1736;font-size:.86rem;line-height:1.4;box-shadow:0 14px 30px -14px rgba(0,0,0,.6)}
.msg .mh{display:flex;gap:8px;align-items:center;margin-bottom:6px;font-size:.7rem;color:#5d6b8e}
.msg .mh .appi{width:22px;height:22px;border-radius:6px}
.msg .mh .appi i b{width:3px;height:10px}
.ba{display:grid;gap:6px}
.ba .old{font-family:ui-monospace,Menlo,monospace;font-size:.82rem;letter-spacing:.04em;color:#cfd5e3;background:#2e3342;padding:9px 12px;border-radius:10px}
.ba .arrow{justify-self:center;color:var(--c);font-size:1.1rem;line-height:1}
.ba .new{font-size:.86rem;line-height:1.4;color:#0b1736;background:#f3f5fa;padding:10px 12px;border-radius:10px}
.ba .new b{color:#1f5be0;font-weight:500}
.wa{background:#ece5dd;border-radius:16px;padding:10px;display:grid;gap:6px;font-size:.82rem;line-height:1.38;color:#111b21;box-shadow:0 14px 30px -14px rgba(0,0,0,.6)}
.wa .b{max-width:88%;padding:7px 10px;border-radius:10px;box-shadow:0 1px 1px rgba(0,0,0,.08)}
.wa .me{justify-self:end;background:#d9fdd3;border-top-right-radius:3px}
.wa .bot{justify-self:start;background:#fff;border-top-left-radius:3px}
.sig ul{list-style:none;margin:8px 0 0;padding:0;display:grid;gap:6px}
.sig li{display:flex;gap:10px;font-size:.92rem;color:var(--dim);line-height:1.4}
.sig li::before{content:"";flex:none;width:7px;height:7px;margin-top:.5em;border-radius:50%;background:var(--c);box-shadow:0 0 8px var(--c)}
.road{display:grid;gap:6px;padding-top:12px;border-top:1px solid var(--line-soft)}
.road .rl{font-family:var(--cond);font-weight:700;font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:var(--mute)}
.road .rl.on{color:var(--c)}
.chip.live{border-color:var(--c);background:rgba(34,201,141,.14)}
.chip.muse{border-color:rgba(37,211,102,.7);background:rgba(37,211,102,.12)}
.hyper{margin-top:22px;padding:18px 22px;display:grid;grid-template-columns:auto minmax(0,1fr);gap:16px;align-items:center;border-color:rgba(255,138,61,.55);box-shadow:0 0 24px rgba(255,138,61,.16)}
.hyper .ico{width:46px;height:46px;border-radius:12px;border:1.5px solid var(--orange);display:grid;place-items:center;color:var(--orange);box-shadow:0 0 14px rgba(255,138,61,.35)}
.hyper .ico svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round}
.hyper p{color:var(--dim)}
.hyper b{color:var(--fg);font-weight:500}

/* RESULTS */
.res-grid{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:20px;align-items:stretch}
.res-col{padding:clamp(20px,2.6vw,28px);display:flex;flex-direction:column}
.res-col > h3{font-family:var(--cond);font-weight:700;font-size:.85rem;letter-spacing:.14em;text-transform:uppercase;color:var(--cyan);margin-bottom:22px}
.rings{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-block:auto}
.rcell{display:grid;justify-items:center;align-content:start;text-align:center;gap:12px}
.ring{--rs:clamp(118px,10.5vw,148px);position:relative;width:var(--rs);height:var(--rs);max-width:100%}
.ring svg{width:100%;height:100%;transform:rotate(-90deg);overflow:visible}
.ring .rt{fill:none;stroke:rgba(150,180,255,.12);stroke-width:7}
.ring .ra{fill:none;stroke:var(--c);stroke-width:7;stroke-linecap:round;stroke-dasharray:100;stroke-dashoffset:7;filter:drop-shadow(0 0 6px var(--c)) drop-shadow(0 0 14px var(--c));transition:stroke-dashoffset 1.8s cubic-bezier(.2,.7,.2,1)}
.ring .ri{fill:none;stroke:var(--c);stroke-width:1;opacity:.35}
.rin{position:absolute;inset:0;display:grid;place-items:center;align-content:center;gap:4px}
.rnum{font-family:var(--display);font-weight:800;font-size:calc(var(--rs)*.25);line-height:1;letter-spacing:-.04em;font-variant-numeric:tabular-nums;white-space:nowrap}
.rnum small{font-size:.6em}
.long .rnum{font-size:calc(var(--rs)*.19)}
.rsub{font-family:var(--cond);font-size:calc(var(--rs)*.08);letter-spacing:.08em;text-transform:uppercase;color:var(--c)}
.rlabel{font-family:var(--cond);font-weight:700;font-size:1.05rem;line-height:1.25}
.rlabel span{display:block;font-family:var(--body);font-weight:400;font-size:.88rem;color:var(--dim);margin-top:3px}
.ops{display:grid;gap:16px}
.op{display:grid;grid-template-columns:auto minmax(0,1fr);gap:14px;align-items:start}
.op .ico{width:44px;height:44px;border-radius:50%;border:1.5px solid var(--c);color:var(--c);display:grid;place-items:center;box-shadow:0 0 14px var(--c)}
.op .ico svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.op b{display:block;font-family:var(--cond);font-weight:700;font-size:1.1rem}
.op span{color:var(--dim);font-size:.93rem}
.res-foot{margin-top:18px;display:flex;gap:12px 20px;align-items:center;flex-wrap:wrap}
.res-foot .lbl{font-family:var(--cond);font-weight:700;color:var(--dim)}

/* CTA */
.cta h2{font-family:var(--display);font-weight:800;font-size:clamp(2rem,4.6vw,3.3rem);line-height:1.05;letter-spacing:-.02em;max-width:18ch;margin-top:12px}
.cta .lede{color:var(--dim);font-size:1.1rem;margin-top:14px;max-width:58ch}
.pilot{list-style:none;margin:52px 0 0;padding:0;display:grid;grid-template-columns:1fr auto 1fr auto 1fr;gap:12px;align-items:stretch}
.pstep{position:relative;padding:42px 22px 22px;text-align:center;display:grid;gap:6px;align-content:start}
.pilot .num{position:absolute;top:0;left:50%;transform:translate(-50%,-50%);width:56px;height:56px;border-radius:50%;display:grid;place-items:center;font-family:var(--display);font-weight:800;font-size:1.35rem;background:var(--bg);border:2px solid var(--cyan);box-shadow:0 0 18px rgba(79,208,255,.5)}
.pilot h3{font-family:var(--cond);font-weight:700;font-size:1.2rem;color:var(--orange)}
.pilot p{color:var(--dim);font-size:.95rem}
.chev{display:grid;place-items:center;color:var(--cyan);font-size:2rem;text-shadow:0 0 12px var(--cyan)}
.cta-row{display:flex;flex-wrap:wrap;gap:18px 30px;align-items:center;margin-top:42px}
.btn{display:inline-flex;align-items:center;gap:12px;background:linear-gradient(135deg,#25d366,#13a14d);color:#fff;text-decoration:none;font-family:var(--display);font-weight:700;font-size:1.08rem;padding:17px 28px;border-radius:999px;box-shadow:0 0 30px rgba(37,211,102,.4),0 10px 30px -10px rgba(0,0,0,.6);transition:transform .2s ease,box-shadow .2s ease}
.btn:hover{transform:translateY(-2px);box-shadow:0 0 44px rgba(37,211,102,.6),0 14px 30px -10px rgba(0,0,0,.6)}
.btn svg{width:22px;height:22px}
.contact{color:var(--dim);font-size:.98rem;line-height:1.6}
.contact b{color:var(--fg);font-weight:500}
.copy{background:transparent;border:1px solid var(--line);color:var(--fg);font:inherit;font-size:.82rem;padding:3px 11px;border-radius:999px;cursor:pointer;margin-left:8px}
.copy:hover{border-color:var(--cyan)}
.sign{margin-top:44px;padding-top:20px;border-top:1px solid var(--line-soft);display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;color:var(--mute);font-size:.88rem}
.sign b{font-family:var(--display);color:var(--fg);font-weight:600}

.brands{display:flex;flex-wrap:wrap;justify-content:center;gap:14px}
.brand{flex:0 1 calc((100% - 3*14px)/4);min-height:96px;display:grid;place-items:center;padding:18px;border-radius:16px}
.brand span{font-family:var(--display);font-weight:700;font-size:clamp(1rem,1.8vw,1.3rem);letter-spacing:.02em;color:var(--fg);text-align:center}
.brand img{max-width:80%;max-height:48px;width:auto;height:auto}
@media (max-width:640px){.brand{flex-basis:calc((100% - 14px)/2);min-height:80px}}
/* Reveal */
.rv{transition:opacity .75s ease,transform .75s cubic-bezier(.2,.7,.2,1),translate .25s ease;transition-delay:var(--d,0ms),var(--d,0ms),0ms}
.rv.pre{opacity:0;transform:translateY(32px)}

@media (max-width:1000px){.prods{grid-template-columns:1fr;max-width:620px}.res-grid{grid-template-columns:1fr}}
@media (max-width:820px){.rings{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:24px}}
@media (max-width:900px){.hero-grid{grid-template-columns:1fr}.stage{max-width:340px;margin-top:10px}}
@media (max-width:640px){
  body{font-size:16px}
  .rings{grid-template-columns:repeat(2,minmax(0,1fr))}
  .pilot{grid-template-columns:1fr;gap:36px}
  .chev{display:none}
  .hyper{grid-template-columns:1fr}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}.progress{display:none}}
</style></head><body>

